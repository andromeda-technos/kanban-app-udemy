# Salin file ini menjadi `.env.local` lalu isi nilainya.
# `.env.local` tidak ikut ke Git (sudah ada di .gitignore lewat pola *.local).
# Semua nilai di bawah ini aman berada di frontend (bukan secret).

# Supabase → Project Settings → API Keys / Data API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Google Cloud → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=
# Google Cloud → Project settings → Project number (dipakai Google Picker)
VITE_GOOGLE_APP_ID=
